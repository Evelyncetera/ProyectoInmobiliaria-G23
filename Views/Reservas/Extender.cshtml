@model Reserva

@{
    var original = ViewBag.Original as Reserva;
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Renovar / Extender Reserva</h2>
        </div>
        <div class="card-body">
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle-fill"></i>
                Al renovar/extender se genera una <strong>nueva reserva</strong> con el mismo inquilino e inmueble.
                La reserva original (Código @(original?.IdReserva)) no se modifica.
            </div>

            @if (original != null)
            {
                <div class="mb-4 p-3 bg-light border rounded">
                    <h6 class="text-muted mb-2">Reserva original @original.IdReserva</h6>
                    <p class="mb-1"><strong>Inquilino:</strong> @original.NombreInquilino @original.ApellidoInquilino (@original.DniInquilino)</p>
                    <p class="mb-1"><strong>Inmueble:</strong> @original.DireccionInmueble</p>
                    <p class="mb-1"><strong>Período:</strong> @original.FechaDesde.ToString("dd/MM/yyyy") a @original.FechaHasta.ToString("dd/MM/yyyy")</p>
                    <p class="mb-0"><strong>Monto por día:</strong> @original.MontoPorDia.ToString("C")</p>
                </div>
            }

            <form asp-action="Extender" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.Error
                    </div>
                }

                <div class="row">
                    <!-- Inquilino -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdInquilino" class="form-label font-weight-bold">Inquilino</label>
                        <select asp-for="IdInquilino" class="form-select" asp-items="ViewBag.Inquilinos">
                            <option value="">-- Seleccione un inquilino --</option>
                        </select>
                        <span asp-validation-for="IdInquilino" class="text-danger"></span>
                    </div>

                    <!-- Inmueble -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdInmueble" class="form-label font-weight-bold">Inmueble</label>
                        <select asp-for="IdInmueble" class="form-select" asp-items="ViewBag.Inmuebles">
                            <option value="">-- Seleccione un inmueble --</option>
                        </select>
                        <span asp-validation-for="IdInmueble" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Fecha desde -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="FechaDesde" class="form-label font-weight-bold">Nueva fecha de inicio</label>
                        <input asp-for="FechaDesde" type="date" class="form-control" />
                        <span asp-validation-for="FechaDesde" class="text-danger"></span>
                    </div>

                    <!-- Fecha hasta -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="FechaHasta" class="form-label font-weight-bold">Nueva fecha de finalización</label>
                        <input asp-for="FechaHasta" type="date" class="form-control" />
                        <span asp-validation-for="FechaHasta" class="text-danger"></span>
                    </div>

                    <!-- Monto por día -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="MontoPorDia" class="form-label font-weight-bold">Nuevo monto por día</label>
                        <input asp-for="MontoPorDia" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="MontoPorDia" class="text-danger"></span>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-clipboard-plus-fill"></i> Generar Nueva Reserva
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>