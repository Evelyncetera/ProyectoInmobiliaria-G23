@model IEnumerable<Reserva>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">Reservas por terminar</h1>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <!-- Selector de plazo -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="ReportePorTerminar" class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <label for="dias" class="form-label mb-0 fw-bold">Reservas que terminan en:</label>
                <div class="input-group w-auto">
                    <input id="dias" name="dias" type="number" min="1" value="@ViewBag.Dias" class="form-control" style="max-width: 120px;" />
                    <span class="input-group-text">días</span>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel-fill"></i> Filtrar</button>
            </form>
            <p class="text-muted mb-0">Período evaluado: desde hoy hasta @ViewBag.Dias días.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Inquilino</th>
                            <th>Inmueble</th>
                            <th>Desde</th>
                            <th>Hasta</th>
                            <th>Faltan</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var reserva in Model)
                        {
                            var faltan = (reserva.FechaHasta.Date - DateTime.Today).Days;
                            <tr>
                                <td class="fw-bold">@reserva.IdReserva</td>
                                <td>@reserva.NombreInquilino @reserva.ApellidoInquilino</td>
                                <td>@reserva.DireccionInmueble</td>
                                <td>@reserva.FechaDesde.ToString("dd/MM/yyyy")</td>
                                <td>@reserva.FechaHasta.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge @(faltan <= 3 ? "bg-danger" : "bg-warning text-dark")">@faltan días</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted"><i class="bi bi-info-circle display-6 d-block mb-2 text-secondary"></i>No hay reservas que terminen en los próximos @ViewBag.Dias días.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>