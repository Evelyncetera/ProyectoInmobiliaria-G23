@model IEnumerable<Inmueble>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">Inmuebles sin reservas</h1>
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <!-- Selector de días -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="ReporteSinReservas" class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <label for="dias" class="form-label mb-0 fw-bold">Sin reservas en los últimos:</label>
                <select id="dias" name="dias" class="form-select w-auto">
                    <option value="30" selected="@(ViewBag.Dias == 30)">30 días</option>
                    <option value="60" selected="@(ViewBag.Dias == 60)">60 días</option>
                    <option value="90" selected="@(ViewBag.Dias == 90)">90 días</option>
                    <option value="120" selected="@(ViewBag.Dias == 120)">120 días</option>
                </select>
                <button type="submit" class="btn btn-primary"><i class="bi bi-funnel-fill"></i> Filtrar</button>
            </form>
            <p class="text-muted mb-0">Período evaluado: últimos @ViewBag.Dias días.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Dirección</th>
                            <th>Cupo</th>
                            <th>Precio por día</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var inmueble in Model)
                        {
                            <tr>
                                <td class="fw-bold">@inmueble.IdInmueble</td>
                                <td>@inmueble.Direccion</td>
                                <td>@inmueble.Cupo</td>
                                <td>@inmueble.PrecioPorDia.ToString("C")</td>
                                <td><span class="badge @(inmueble.Disponible ? "bg-success" : "bg-secondary")">@(inmueble.Disponible ? "Disponible" : "No disponible")</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted"><i class="bi bi-info-circle display-6 d-block mb-2 text-secondary"></i>Todos los inmuebles tuvieron reservas en los últimos @ViewBag.Dias días.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>