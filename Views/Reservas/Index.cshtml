@model IEnumerable<Reserva>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">Listado de Reservas</h1>
        <a asp-action="Crear" class="btn btn-primary"><i class="bi bi-calendar-plus-fill"></i> Registrar Nueva Reserva</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-bar-chart-fill"></i> Reportes</h5>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="ReporteMasReservados" class="btn btn-outline-primary"><i class="bi bi-trophy-fill"></i> Más reservados (365 días)</a>
                <a asp-action="ReporteSinReservas" class="btn btn-outline-primary"><i class="bi bi-calendar-x"></i> Inmuebles sin reservas</a>
                <a asp-action="ReporteVigentes" class="btn btn-outline-primary"><i class="bi bi-check-circle-fill"></i> Reservas vigentes</a>
                <a asp-action="ReportePorTerminar" class="btn btn-outline-primary"><i class="bi bi-hourglass-split"></i> Reservas por terminar</a>
                <a asp-action="ReporteDisponibles" class="btn btn-outline-primary"><i class="bi bi-house-check-fill"></i> Inmuebles disponibles</a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <colgroup>
                        <col />
                        <col />
                        <col />
                        <col />
                        <col />
                        <col />
                        <col />
                        <col style="width: 380px;" />
                    </colgroup>
                    <thead class="table-dark">
                        <tr>
                            <th>Código</th>
                            <th>Inquilino</th>
                            <th>Inmueble</th>
                            <th>Desde</th>
                            <th>Hasta</th>
                            <th>Monto por día</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var reserva in Model)
                        {
                            var vigente = !reserva.Anulada && reserva.FechaDesde <= DateTime.Today && reserva.FechaHasta >= DateTime.Today;
                            <tr class="@(reserva.Anulada ? "table-secondary" : vigente ? "table-success" : "")">
                                <td class="fw-bold">@reserva.IdReserva</td>
                                <td class="text-wrap">@reserva.NombreInquilino @reserva.ApellidoInquilino <small class="text-muted">(@reserva.DniInquilino)</small></td>
                                <td class="text-wrap">@reserva.DireccionInmueble</td>
                                <td class="text-nowrap">@reserva.FechaDesde.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">@reserva.FechaHasta.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">@reserva.MontoPorDia.ToString("C")</td>
                                <td>
                                    @if (reserva.Anulada)
                                    {
                                        <span class="badge bg-secondary"><i class="bi bi-x-circle-fill"></i> Anulada</span>
                                    }
                                    else if (vigente)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Vigente</span>
                                    }
                                    else if (reserva.FechaHasta < DateTime.Today)
                                    {
                                        <span class="badge bg-dark"><i class="bi bi-clock-history"></i> Vencida</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark"><i class="bi bi-calendar-event-fill"></i> Programada</span>
                                    }
                                </td>
                                <td class="text-center" style="width: 280px; min-width: 280px;">
                                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-1" role="group">
                                        <div class="col">
                                            <a asp-action="Detalles" asp-route-id="@reserva.IdReserva" class="btn btn-info btn-sm text-white text-wrap w-100"><i class="bi bi-eye-fill"></i> Detalles</a>
                                        </div>
                                        <div class="col">
                                            <a asp-action="Editar" asp-route-id="@reserva.IdReserva" class="btn btn-warning btn-sm text-wrap w-100"><i class="bi bi-pencil-fill"></i> Editar</a>
                                        </div>
                                        <div class="col">
                                            <a asp-action="Extender" asp-route-id="@reserva.IdReserva" class="btn btn-primary btn-sm text-wrap w-100"><i class="bi bi-arrow-repeat"></i> Renovar</a>
                                        </div>
                                        @if (!reserva.Anulada)
                                        {
                                            <div class="col">
                                                <form asp-action="Eliminar" asp-route-id="@reserva.IdReserva" method="post" class="w-100" onsubmit="return confirm('¿Anular la reserva @reserva.IdReserva de @reserva.NombreInquilino @reserva.ApellidoInquilino? Esta acción no se puede deshacer.');">
                                                    <button type="submit" class="btn btn-danger btn-sm text-wrap w-100"><i class="bi bi-trash-fill"></i> Anular</button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted"><i class="bi bi-info-circle display-6 d-block mb-2 text-secondary"></i>No hay reservas registradas en el sistema.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>