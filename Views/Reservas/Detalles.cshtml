@model Reserva

@{
    var vigente =  !Model.Anulada && !Model.FechaTerminacion.HasValue &&
                        Model.FechaDesde.Date <= DateTime.Today && Model.FechaHasta.Date >= DateTime.Today;

    var puedeEditar =
        !Model.Anulada &&
        !Model.FechaTerminacion.HasValue &&
        Model.FechaHasta.Date >= DateTime.Today;

}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Detalles de la Reserva</h2>
        </div>
        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-md-4">Código interno</dt>
                <dd class="col-md-8">@Model.IdReserva</dd>
                <dt class="col-md-4">Inquilino</dt>
                <dd class="col-md-8">@Model.NombreInquilino @Model.ApellidoInquilino (@Model.DniInquilino)</dd>
                <dt class="col-md-4">Inmueble</dt>
                <dd class="col-md-8">@Model.DireccionInmueble</dd>
                <dt class="col-md-4">Fecha de inicio</dt>
                <dd class="col-md-8">@Model.FechaDesde.ToString("dd/MM/yyyy")</dd>
                <dt class="col-md-4">Fecha de finalización</dt>
                <dd class="col-md-8">@Model.FechaHasta.ToString("dd/MM/yyyy")</dd>
                <dt class="col-md-4">Monto por día</dt>
                <dd class="col-md-8">@Model.MontoPorDia.ToString("C")</dd>
                <dt class="col-md-4">Estado</dt>
                <dd class="col-md-8">
                    @if (Model.Anulada)
                    {
                        <span class="badge bg-secondary"><i class="bi bi-x-circle-fill"></i> 
                            Anulada
                        </span>
                    }
                    else if (vigente)
                    {
                        <span class="badge bg-danger"><i class="bi bi-x-octagon-fill"></i>
                            Terminada anticipadamente
                        </span>
                    }
                    else if (vigente)
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> 
                            Vigente
                        </span>
                    }
                    else if (Model.FechaHasta < DateTime.Today)
                    {
                        <span class="badge bg-dark"><i class="bi bi-clock-history"></i> 
                            Vencida
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark"><i class="bi bi-calendar-event-fill"></i> 
                            Programada
                        </span>
                    }
                </dd>
            </dl>


            @if (User.IsInRole("Administrador"))
            {
                <hr />
                <h3 class="h5">Auditoría</h3>
                <dl class="row">
                    <dt class="col-md-4">Creada por</dt>
                    <dd class="col-md-8">
                        @(Model.NombreUsuarioCreador ?? "Sin información")
                        @if (Model.FechaCreacion != default)
                        {
                            <span>(@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm"))</span>
                        }
                    </dd>
                    <dt class="col-md-4">Anulada por</dt>
                    <dd class="col-md-8">
                        @(Model.NombreUsuarioAnulador ?? "No anulada")
                        @if (Model.FechaAnulacion.HasValue)
                        {
                            <span>(@Model.FechaAnulacion.Value.ToString("dd/MM/yyyy HH:mm"))</span>
                        }
                    </dd>
                    <dt class="col-md-4">Terminada por</dt>
                    <dd class="col-md-8">
                        @(Model.NombreUsuarioTerminador ?? "No terminada anticipadamente")

                        @if (Model.FechaTerminacion.HasValue)
                        {
                            <span>
                                (@Model.FechaTerminacion.Value.ToString("dd/MM/yyyy"))
                            </span>
                        }
                    </dd>
                </dl>
            }
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
                <div>
                    <a asp-controller="Pago"
                        asp-action="Crear"
                        asp-route-id="@Model.IdReserva"
                        class="btn btn-success">
                            <i class="bi bi-cash"></i> Generar Nuevo Pago
                        </a>

                        <a asp-action="Extender"
                        asp-route-id="@Model.IdReserva"
                        class="btn btn-primary">
                            <i class="bi bi-arrow-repeat"></i> Renovar/Extender
                        </a>

                        @if (vigente && !Model.FechaTerminacion.HasValue)
                        {
                            <a asp-action="Terminar"
                            asp-route-id="@Model.IdReserva"
                            class="btn btn-danger">
                                <i class="bi bi-x-octagon"></i> Terminar anticipadamente
                            </a>
                        }

                        @if (puedeEditar)
                        {
                            <a asp-action="Editar"
                            asp-route-id="@Model.IdReserva"
                            class="btn btn-warning text-dark">
                                <i class="bi bi-pencil-fill"></i> Editar
                            </a>
                        }
                </div>
            </div>
        </div>
    </div>
</div>