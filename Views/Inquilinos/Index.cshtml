@model IEnumerable<Inquilino>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-success fw-bold">Listado de Inquilinos</h1>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Inquilino
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>DNI</th>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th class="text-center" style="width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Dni</td>
                                    <td>@item.Nombre @item.Apellido</td>
                                    <td>@item.Email</td>
                                    <td>@(string.IsNullOrEmpty(item.Telefono) ? "No registrado" : item.Telefono)</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- Envía el Id al método Editar del controlador -->
                                            <a asp-action="Editar" asp-route-id="@item.IdInquilino" class="btn btn-warning btn-sm">
                                                <i class="bi bi-pencil-fill"></i> Editar
                                            </a>
                                            <!-- Envía el Id al método Eliminar del controlador -->
                                            <a asp-action="Eliminar" asp-route-id="@item.IdInquilino" class="btn btn-danger btn-sm">
                                                <i class="bi bi-trash-fill"></i> Eliminar
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle display-6 d-block mb-2 text-secondary"></i>
                                    No hay inquilinos registrados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>