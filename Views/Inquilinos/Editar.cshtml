@model Inquilino

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h2 class="mb-0">Modificar Datos del Inquilino</h2>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Campo oculto MUY IMPORTANTE para identificar el registro al guardar -->
                <input type="hidden" asp-for="IdInquilino" />

                <div class="row">
                    <!-- Documento (DNI) -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Dni" class="form-label font-weight-bold">DNI / Documento</label>
                        <input asp-for="Dni" class="form-control" required />
                        <span asp-validation-for="Dni" class="text-danger"></span>
                    </div>

                    <!-- Teléfono -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label font-weight-bold">Teléfono de Contacto</label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Nombre -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label font-weight-bold">Nombre</label>
                        <input asp-for="Nombre" class="form-control" required />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <!-- Apellido -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Apellido" class="form-label font-weight-bold">Apellido</label>
                        <input asp-for="Apellido" class="form-control" required />
                        <span asp-validation-for="Apellido" class="text-danger"></span>
                    </div>
                </div>

                <!-- Correo Electrónico -->
                <div class="mb-4">
                    <label asp-for="Email" class="form-label font-weight-bold">Correo Electrónico</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Botones de Acción -->
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-warning text-dark">
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>