@model IEnumerable<TipoInmueble>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary fw-bold">Tipos de Inmueble</h1>
        <div class="d-flex gap-2">
            <a asp-controller="Inmueble" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Volver a Inmuebles
            </a>
            <a asp-action="Crear" class="btn btn-primary">
                <i class="bi bi-plus-circle-fill"></i> Nuevo Tipo
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 20%;">Código</th>
                            <th>Nombre</th>
                            <th class="text-center" style="width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var tipo in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@tipo.IdTipoInmueble</td>
                                    <td>@tipo.Nombre</td>
                                    <td class="text-center">
                                        <div class="row row-cols-1 row-cols-md-2 g-1">
                                            <div class="col">
                                                <a asp-action="Editar" asp-route-id="@tipo.IdTipoInmueble" class="btn btn-warning btn-sm w-100">
                                                    <i class="bi bi-pencil-fill"></i> Editar
                                                </a>
                                            </div>
                                            <div class="col">
                                                <a asp-action="Eliminar" asp-route-id="@tipo.IdTipoInmueble" class="btn btn-danger btn-sm w-100">
                                                    <i class="bi bi-trash-fill"></i> Eliminar
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle display-6 d-block mb-2 text-secondary"></i>
                                    No hay tipos de inmueble registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
