@model IEnumerable<Propietario>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-success fw-bold">Listado de Propietarios</h1>
        <a asp-action="Crear" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Registrar Nuevo Propietario
        </a>
    </div>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <colgroup>
                        <col style="width: 12%;" />
                        <col style="width: 25%;" />
                        <col style="width: 20%;" />
                        <col style="width: 18%;" />
                        <col style="width: 25%;" />
                    </colgroup>
                    <thead class="table-dark">
                        <tr>
                            <th>DNI</th>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-bold">@p.Dni</td>
                                <td>@p.Nombre @p.Apellido</td>
                                <td class="text-break">@p.Email</td>
                                <td>@p.Telefono</td>
                                <td class="text-center">
                                    <!-- Los tag helpers "asp-route-id" pasan el ID del propietario al controlador -->
                                    <div class="row row-cols-1 row-cols-md-3 g-1" role="group">
                                        <div class="col">
                                            <a asp-action="Detalles" asp-route-id="@p.IdPropietario"
                                               class="btn btn-info btn-sm text-white w-100">
                                                <i class="bi bi-eye-fill"></i> Detalles
                                            </a>
                                        </div>
                                        <div class="col">
                                            <a asp-action="Editar" asp-route-id="@p.IdPropietario"
                                               class="btn btn-warning btn-sm w-100">
                                                <i class="bi bi-pencil-fill"></i> Editar
                                            </a>
                                        </div>
                                        <div class="col">
                                            <form asp-action="Eliminar" asp-route-id="@p.IdPropietario" method="post"
                                                  class="w-100"
                                                  onsubmit="return confirm('¿Eliminar a @p.Nombre @p.Apellido? Esta acción no se puede deshacer.');">
                                                <button type="submit" class="btn btn-danger btn-sm w-100">
                                                    <i class="bi bi-trash-fill"></i> Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>