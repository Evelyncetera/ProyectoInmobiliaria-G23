@model Inmueble
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="IdInmueble" type="hidden" />
<div class="row g-3">
    <div class="col-md-6" data-selector-remoto>
        <label for="buscar-propietario" class="form-label">Buscar propietario por nombre o DNI</label>
        <div class="input-group mb-2">
            <input id="buscar-propietario" type="search" class="form-control" data-busqueda maxlength="100" />
            <button type="button" class="btn btn-outline-secondary" data-buscar>Buscar</button>
        </div>
        <label asp-for="IdPropietario" class="form-label"></label>
        <select asp-for="IdPropietario" asp-items="ViewBag.Propietarios" class="form-select" data-resultados data-url="@Url.Action("BuscarPropietarios")" required>
            <option value="">Seleccioná un propietario</option>
        </select>
        <small class="text-muted" data-mensaje aria-live="polite">Buscá para cargar hasta 20 coincidencias.</small>
    </div>
    <div class="col-md-6" data-selector-remoto>
        <label for="buscar-tipo" class="form-label">Buscar tipo de inmueble</label>
        <div class="input-group mb-2">
            <input id="buscar-tipo" type="search" class="form-control" data-busqueda maxlength="100" />
            <button type="button" class="btn btn-outline-secondary" data-buscar>Buscar</button>
        </div>
        <label asp-for="IdTipoInmueble" class="form-label"></label>
        <select asp-for="IdTipoInmueble" asp-items="ViewBag.TiposInmuebles" class="form-select" data-resultados data-url="@Url.Action("BuscarTipos")" required>
            <option value="">Seleccioná un tipo</option>
        </select>
        <small class="text-muted" data-mensaje aria-live="polite">Buscá para cargar hasta 20 coincidencias.</small>
    </div>
    <div class="col-md-8">
        <label asp-for="Direccion" class="form-label"></label>
        <input asp-for="Direccion" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="Cupo" class="form-label"></label>
        <input asp-for="Cupo" type="number" min="1" class="form-control" />
    </div>
    <div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Latitud" class="form-label"></label>
        <input asp-for="Latitud" class="form-control" type="number" step="any" />
        <span asp-validation-for="Latitud" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Longitud" class="form-label"></label>
        <input asp-for="Longitud" class="form-control" type="number" step="any" />
        <span asp-validation-for="Longitud" class="text-danger"></span>
    </div>
    </div>

    <div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="PrecioPorDia" class="form-label"></label>
        <input asp-for="PrecioPorDia" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="PrecioPorDia" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="PorcentajeReserva" class="form-label"></label>
        <input asp-for="PorcentajeReserva" class="form-control" type="number" step="0.01" min="0" max="100" />
        <span asp-validation-for="PorcentajeReserva" class="text-danger"></span>
    </div>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="Disponible" class="form-check-input" />
            <label asp-for="Disponible" class="form-check-label">Ofrecer para nuevas reservas</label>
        </div>
        <small class="text-muted">Al desmarcarlo, la oferta se suspende. Las reservas existentes se conservan.</small>
    </div>
    <div class="col-12">
        <label for="imagenes" class="form-label">@(Model.IdInmueble == 0 ? "Imágenes" : "Agregar imágenes")</label>
        <input id="imagenes" name="imagenes" type="file" multiple accept="image/jpeg,image/png,image/webp" class="form-control" data-imagenes />
        <small class="text-muted">JPG, PNG o WebP. Hasta 5 MB por imagen, 30 MB por envío y 12 imágenes por inmueble. La primera será la portada; podés cambiarla en detalles.</small>
        <div class="row g-2 mt-1" data-previsualizaciones></div>
        <noscript><p>Activá JavaScript para buscar propietarios y tipos y previsualizar imágenes.</p></noscript>
    </div>
</div>
